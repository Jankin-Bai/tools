// ============================================================================
// gr5526-ci : GR5526 compile -> flash -> test closed loop
// ============================================================================
//
// ARCHITECTURE
//
//   Jenkins SCM
//       |
//       +-- Jenkinsfile
//       +-- CI tools
//       |
//       v
//   GR5526 Hardware Agent
//       |
//       +-- Local Bootloader project
//       +-- Local APP project
//       +-- GR5xxx_console
//       +-- J-Link
//       +-- DUT
//
// Firmware source code is NOT stored in SCM.
// Firmware projects are selected at build time through:
//   BL_PROJECT_PATH
//   APP_PROJECT_PATH
//
// HARD RULES (MANDATORY - never change):
//   - GR5xxx_console for ALL flash ops (erase/program/dump/reset).
//   - NO J-Link flash/reset.
//   - Flash order: App FIRST, Bootloader LAST.
//   - Erase only: BL region, Bank A, Bank B.
//   - NVDS (0x002EF000) MUST be preserved.
//   - NO eraseall.
//   - Production addresses come from detect_firmware_layout.py.
//   - DRY_RUN defaults true.
//   - Pure ASCII output.
//
// ============================================================================


// ============================================================================
// GR5xxx_console wrapper
// ============================================================================
//
// All GR5xxx_console operations go through this function.
//
// This keeps the hardware flow readable while enforcing:
//   1. DRY_RUN
//   2. GR5xxx_console usage
//   3. common logging
//
def grConsole(String args) {
    def dryRun =
        (env.DRY_RUN == 'true' ||
         env.DRY_RUN == 'True' ||
         env.DRY_RUN == null)

    if (dryRun) {
        echo "[DRY-RUN] GR5xxx_console: ${args}"
    } else {
        echo "[GR5526-CI] GR5xxx_console ${args}"
        bat "@\"${env.GR_CONSOLE}\" ${args}"
    }
}


pipeline {

    // ========================================================================
    // Hardware Agent
    // ========================================================================

    agent {
        label 'gr5526-hw'
    }


    // ========================================================================
    // Jenkins Options
    // ========================================================================

    options {

        buildDiscarder(
            logRotator(
                numToKeepStr: '30'
            )
        )

        timeout(
            time: 30,
            unit: 'MINUTES'
        )

        // One Hardware Agent owns:
        //   DUT + J-Link + GR5xxx_console
        //
        // Do not allow two builds to operate on the same hardware.
        disableConcurrentBuilds()
    }


    // ========================================================================
    // Build Parameters
    // ========================================================================

    parameters {

        // --------------------------------------------------------------------
        // Execution control
        // --------------------------------------------------------------------

        booleanParam(
            name: 'DRY_RUN',
            defaultValue: true,
            description: 'true = print commands only, no hardware action'
        )

        booleanParam(
            name: 'SKIP_BUILD',
            defaultValue: false,
            description: 'Skip firmware build stage'
        )

        booleanParam(
            name: 'SKIP_FLASH',
            defaultValue: false,
            description: 'Skip hardware flash stage'
        )


        // --------------------------------------------------------------------
        // Safety switches
        // --------------------------------------------------------------------

        booleanParam(
            name: 'ALLOW_PREBUILT_FIRMWARE',
            defaultValue: false,
            description: 'Allow existing firmware when build fails. WARNING: firmware was NOT produced by current build.'
        )

        booleanParam(
            name: 'ALLOW_LAYOUT_FALLBACK',
            defaultValue: false,
            description: 'Development only. Use hardcoded layout if detection fails. NEVER enable for production CI.'
        )


        // --------------------------------------------------------------------
        // Firmware project selection
        // --------------------------------------------------------------------
        //
        // IMPORTANT:
        //
        // Firmware source is NOT stored in SCM.
        //
        // Select the local build directory on the Hardware Agent.
        //
        // The selected directory MUST contain Makefile.
        //
        // Therefore:
        //
        //     Project Path
        //          |
        //          +-- Makefile
        //          +-- source
        //          +-- include
        //          +-- ...
        //
        // Source + Makefile stay together.
        //

        string(
            name: 'BL_PROJECT_PATH',
            defaultValue: 'D:\\Users\\Administrator\\Documents\\code\\wingcard_cli\\w4\\wc2\\bootloader\\GCC',
            description: 'Local Bootloader build directory containing Makefile'
        )

        string(
            name: 'APP_PROJECT_PATH',
            defaultValue: 'D:\\Users\\Administrator\\Documents\\code\\wingcard_cli\\w4\\wc2\\app\\GCC',
            description: 'Local APP build directory containing Makefile'
        )


        // --------------------------------------------------------------------
        // RTT test configuration
        // --------------------------------------------------------------------

        string(
            name: 'BL_KEYWORD',
            defaultValue: '',
            description: 'BL RTT success keyword. Empty = any output.'
        )

        string(
            name: 'APP_KEYWORD',
            defaultValue: '',
            description: 'APP RTT success keyword. Empty = any output.'
        )
    }


    // ========================================================================
    // Global Environment
    // ========================================================================

    environment {

        // --------------------------------------------------------------------
        // Local CI root
        // --------------------------------------------------------------------

        W4 =
            'D:\\Users\\Administrator\\Documents\\code\\wingcard_cli\\w4'


        // --------------------------------------------------------------------
        // Hardware tools
        // --------------------------------------------------------------------

        GR_CONSOLE =
            'D:\\Program Files (x86)\\Goodix\\GProgrammer\\GR5xxx_console.exe'

        CHIP = 'GR5526'


        // --------------------------------------------------------------------
        // SDK
        // --------------------------------------------------------------------

        BL_SDK =
            'D:\\Users\\Administrator\\Documents\\code\\wingcard_cli\\GR5526.SDK-1.0.3'

        APP_SDK =
            'D:/Users/Administrator/Documents/code/wingcard_cli/GR5526_SDK_V1.0.4'


        // --------------------------------------------------------------------
        // Firmware projects
        // --------------------------------------------------------------------
        //
        // These are selected by Jenkins build parameters.
        //
        BL_GCC / APP_GCC are NOT hardcoded firmware paths anymore.
        //

        BL_GCC = "${params.BL_PROJECT_PATH}"

        APP_GCC = "${params.APP_PROJECT_PATH}"


        // --------------------------------------------------------------------
        // Python / CI tools
        // --------------------------------------------------------------------

        VENV_PY =
            'D:\\Users\\Administrator\\Documents\\code\\wingcard_cli\\w4\\.venv\\Scripts\\python.exe'

        TOOLS =
            'D:\\Users\\Administrator\\Documents\\code\\wingcard_cli\\w4\\tools'

        CI_DIR =
            'D:\\Users\\Administrator\\Documents\\code\\wingcard_cli\\w4\\ci'

        ARTIFACTS =
            'D:\\Users\\Administrator\\Documents\\code\\wingcard_cli\\w4\\artifacts'


        // --------------------------------------------------------------------
        // Hardware constant
        // --------------------------------------------------------------------
        //
        // NVDS is fixed by GR5526 SDK / hardware layout.
        //
        // It is NOT a runtime firmware layout result.
        //
        // NEVER erase this region.
        //

        NVDS_ADDR = '0x002EF000'
    }


    // ========================================================================
    // Pipeline Stages
    // ========================================================================

    stages {


        // ====================================================================
        // Stage 1
        // Prepare Environment
        // ====================================================================

        stage('1. Prepare Environment') {

            stages {


                // ============================================================
                // 1.1 Environment Check
                // ============================================================

                stage('1.1 Environment Check') {

                    steps {

                        echo '[Stage1.1] Starting environment verification'

                        echo "DRY_RUN=${params.DRY_RUN}"
                        echo "SKIP_BUILD=${params.SKIP_BUILD}"
                        echo "SKIP_FLASH=${params.SKIP_FLASH}"

                        echo "ALLOW_PREBUILT_FIRMWARE=${params.ALLOW_PREBUILT_FIRMWARE}"
                        echo "ALLOW_LAYOUT_FALLBACK=${params.ALLOW_LAYOUT_FALLBACK}"


                        script {

                            // ------------------------------------------------
                            // Resolve firmware projects
                            // ------------------------------------------------

                            env.BL_GCC =
                                params.BL_PROJECT_PATH.trim()

                            env.APP_GCC =
                                params.APP_PROJECT_PATH.trim()


                            if (!env.BL_GCC || !env.APP_GCC) {

                                error(
                                    'BL_PROJECT_PATH and APP_PROJECT_PATH are required'
                                )
                            }


                            echo "Bootloader project:"
                            echo "  ${env.BL_GCC}"

                            echo "APP project:"
                            echo "  ${env.APP_GCC}"


                            // ------------------------------------------------
                            // J-Link auto detection
                            // ------------------------------------------------

                            echo '>> J-Link auto-detection'

                            def detectOut = bat(
                                returnStdout: true,
                                script:
                                    '@"%VENV_PY%" "%TOOLS%\\jlink_detect.py"'
                            ).trim()


                            detectOut.split('\n').each { line ->

                                def parts =
                                    line.split('=', 2)

                                if (parts.length == 2) {

                                    def key =
                                        parts[0].trim()

                                    def val =
                                        parts[1].trim()


                                    if (key == 'JLINK_PATH') {

                                        env.JLINK_PATH = val

                                    } else if (key == 'JLINK_SERIAL') {

                                        env.JLINK_SERIAL = val

                                    } else if (key == 'JLINK_IDX') {

                                        env.JLINK_IDX = val

                                    } else if (key == 'JLINK_USB_ID') {

                                        env.JLINK_USB_ID = val
                                    }
                                }
                            }


                            if (!env.JLINK_PATH || !env.JLINK_IDX) {

                                error(
                                    'J-Link auto-detection FAILED - check USB connection and software'
                                )
                            }


                            echo "J-Link:"
                            echo "  path=${env.JLINK_PATH}"
                            echo "  idx=${env.JLINK_IDX}"
                            echo "  serial=${env.JLINK_SERIAL}"
                        }


                        // ----------------------------------------------------
                        // Hardware / tool checks
                        // ----------------------------------------------------

                        bat '''
@if not exist "%GR_CONSOLE%" (
    echo ERROR: GR5xxx_console missing
    exit /b 1
)
'''


                        bat '''
@where arm-none-eabi-gcc >nul 2>&1 || (
    echo ERROR: arm-none-eabi-gcc not in PATH
    exit /b 1
)
'''


                        bat '''
@where mingw32-make >nul 2>&1 || (
    echo ERROR: mingw32-make not in PATH
    exit /b 1
)
'''


                        // ----------------------------------------------------
                        // Firmware project checks
                        // ----------------------------------------------------
                        //
                        // The project directory is selected at build time.
                        // It MUST contain Makefile.
                        //

                        bat '''
@if not exist "%BL_GCC%" (
    echo ERROR: bootloader project directory missing
    exit /b 1
)

@if not exist "%BL_GCC%\\Makefile" (
    echo ERROR: bootloader Makefile missing
    exit /b 1
)

@if not exist "%APP_GCC%" (
    echo ERROR: app project directory missing
    exit /b 1
)

@if not exist "%APP_GCC%\\Makefile" (
    echo ERROR: app Makefile missing
    exit /b 1
)
'''


                        // ----------------------------------------------------
                        // SDK checks
                        // ----------------------------------------------------

                        bat '''
@if not exist "%BL_SDK%" (
    echo ERROR: bootloader SDK missing
    exit /b 1
)

@if not exist "%APP_SDK%" (
    echo ERROR: app SDK missing
    exit /b 1
)
'''


                        // ----------------------------------------------------
                        // CI tools
                        // ----------------------------------------------------

                        bat '''
@if not exist "%TOOLS%\\detect_firmware_layout.py" (
    echo ERROR: detect_firmware_layout.py missing
    exit /b 1
)

@if not exist "%TOOLS%\\generate_image_info.py" (
    echo ERROR: generate_image_info.py missing
    exit /b 1
)

@if not exist "%TOOLS%\\test_rtt_with_jump.py" (
    echo ERROR: test_rtt_with_jump.py missing
    exit /b 1
)

@if not exist "%TOOLS%\\verify_flash.py" (
    echo ERROR: verify_flash.py missing
    exit /b 1
)

@if not exist "%TOOLS%\\firmware_metadata.py" (
    echo ERROR: firmware_metadata.py missing
    exit /b 1
)

@if not exist "%CI_DIR%\\flash_plan.py" (
    echo ERROR: ci/flash_plan.py missing
    exit /b 1
)
'''


                        echo '[PASS] env-check: all tools and firmware projects verified'
                    }
                }


                // ============================================================
                // 1.2 Python Venv
                // ============================================================

                stage('1.2 Python Venv Setup') {

                    steps {

                        echo '[Stage1.2] Setting up Python virtual environment'

                        script {

                            if (params.DRY_RUN.toBoolean()) {

                                echo '[DRY-RUN] would create/activate venv and install requirements'

                            } else {

                                bat '''
@echo off

cd /d "%W4%"

if not exist ".venv\\Scripts\\python.exe" (

    echo [venv] Creating virtual environment...

    python -m venv .venv

) else (

    echo [venv] Reusing existing virtual environment

)


echo [venv] Installing dependencies...

".venv\\Scripts\\python.exe" -m pip install --quiet -r requirements.txt


echo [venv] Setup complete

".venv\\Scripts\\python.exe" --version
'''
                            }
                        }


                        echo '[PASS] venv-setup complete'
                    }
                }
            }
        }


        // ====================================================================
        // Stage 2
        // Build
        // ====================================================================

        stage('2. Build') {

            when {

                expression {

                    return !params.SKIP_BUILD.toBoolean()
                }
            }


            parallel {


                // ============================================================
                // 2.1 Bootloader
                // ============================================================

                stage('2.1 Build Bootloader') {

                    steps {

                        echo '[Stage2.1] Compiling GR5526 bootloader (SDK 1.0.3)'


                        script {

                            if (params.DRY_RUN.toBoolean()) {

                                echo '[DRY-RUN] would: cd selected BL_PROJECT_PATH'
                                echo '[DRY-RUN] would: mingw32-make clean'
                                echo '[DRY-RUN] would: mingw32-make'
                                echo '[DRY-RUN] would: generate bl_fw.bin'

                                env.BL_BUILD_STATUS = 'dry-run'

                            } else {

                                // ------------------------------------------------
                                // Build Bootloader
                                // ------------------------------------------------

                                bat '''
@echo off

cd /d "%BL_GCC%"

echo [build-boot] Cleaning...

mingw32-make clean 2>&1


echo [build-boot] Compiling...

mingw32-make 2>&1

if errorlevel 1 (

    echo [FAIL] bootloader make failed

    exit /b 1
)


if not exist "out\\app_bootloader.bin" (

    echo [FAIL] app_bootloader.bin not produced

    exit /b 1
)


echo [PASS] bootloader compiled:
echo        out\\app_bootloader.bin
'''


                                // ------------------------------------------------
                                // Generate bootloader image
                                // ------------------------------------------------

                                echo '[build-boot] Generating bl_fw.bin with Image Info via GR5xxx_console'


                                grConsole(
                                    "generate \"${env.BL_GCC}\\out\\app_bootloader.bin\" \"${env.W4}\\bl_fw.bin\" 0x00200000 1024 1"
                                )


                                env.BL_BUILD_STATUS = 'success'


                                echo '[PASS] build-boot: bl_fw.bin generated'
                            }
                        }
                    }
                }


                // ============================================================
                // 2.2 APP
                // ============================================================

                stage('2.2 Build App') {

                    steps {

                        echo '[Stage2.2] Compiling GR5526 APP (SDK 1.0.4)'


                        script {

                            if (params.DRY_RUN.toBoolean()) {

                                echo '[DRY-RUN] would: cd selected APP_PROJECT_PATH'
                                echo '[DRY-RUN] would: mingw32-make SDK_ROOT=...'
                                echo '[DRY-RUN] would: retry link with response file if necessary'
                                echo '[DRY-RUN] would: generate app_fw.bin'

                                env.APP_BUILD_STATUS = 'dry-run'

                            } else {

                                // ------------------------------------------------
                                // Build APP
                                // ------------------------------------------------
                                //
                                // Known issue:
                                // linker command line can become too long.
                                //
                                // Attempt 1:
                                //   normal make
                                //
                                // Attempt 2:
                                //   response file
                                //

                                def appRc = bat(
                                    returnStatus: true,
                                    script: '''
@echo off

cd /d "%APP_GCC%"


echo [build-app] Cleaning...

mingw32-make SDK_ROOT="%APP_SDK%" clean 2>&1


echo [build-app] Compiling (attempt 1)...

mingw32-make SDK_ROOT="%APP_SDK%" 2>&1


if exist "out\\lst\\ble_app_uart_c.elf" goto build_ok


echo [WARN] Link failed on attempt 1.
echo [WARN] Retrying with response file...


if not exist "out\\obj" goto build_fail


dir /b /s out\\obj\\*.o > obj_list.txt


echo [build-app] Linking (attempt 2 with response file)...

mingw32-make SDK_ROOT="%APP_SDK%" OBJ_ADJUST="@obj_list.txt" 2>&1


if exist "out\\lst\\ble_app_uart_c.elf" goto build_ok


goto build_fail


:build_ok

echo [build-app] Generating .bin...


if not exist "out\\ble_app_uart_c.bin" goto build_fail


echo [PASS] app compiled:
echo        out\\ble_app_uart_c.bin

exit /b 0


:build_fail

echo [WARN] App build failed.


if exist "%W4%\\app_fw.bin" (

    echo [INFO] Existing app_fw.bin found (pre-built)

    exit /b 2

) else (

    echo [FAIL] App build failed and no existing app_fw.bin found

    exit /b 1
)
'''
                                )


                                echo "[build-app] make exit code: ${appRc}"


                                if (appRc == 0) {

                                    // ------------------------------------------------
                                    // Generate app image
                                    // ------------------------------------------------

                                    echo '[build-app] Generating app_fw.bin with Image Info'


                                    bat(
                                        '@"%VENV_PY%" "%TOOLS%\\generate_image_info.py" ' +
                                        '--input "%APP_GCC%\\out\\ble_app_uart_c.bin" ' +
                                        '--output "%W4%\\app_fw.bin" ' +
                                        '--load-addr 0x00240000 ' +
                                        '--name ble_app_uart_c'
                                    )


                                    env.APP_BUILD_STATUS = 'success'


                                    echo '[PASS] build-app: app_fw.bin generated from fresh build'


                                } else if (appRc == 2) {

                                    // ------------------------------------------------
                                    // Prebuilt firmware
                                    // ------------------------------------------------

                                    if (
                                        params.ALLOW_PREBUILT_FIRMWARE.toBoolean()
                                    ) {

                                        env.APP_BUILD_STATUS =
                                            'prebuilt-firmware'


                                        echo '[WARN] WARNING: Using PREBUILT firmware.'
                                        echo '[WARN] This firmware was NOT produced by current build.'

                                    } else {

                                        error(
                                            'App build FAILED and ALLOW_PREBUILT_FIRMWARE=false. ' +
                                            'Set ALLOW_PREBUILT_FIRMWARE=true to use existing app_fw.bin.'
                                        )
                                    }


                                } else {

                                    error(
                                        'App build FAILED and no existing app_fw.bin available'
                                    )
                                }
                            }
                        }
                    }
                }
            }


            post {

                failure {

                    echo '[WARN] Stage 2 build had failures.'


                    script {

                        if (!env.BL_BUILD_STATUS) {

                            env.BL_BUILD_STATUS = 'failed'
                        }


                        if (!env.APP_BUILD_STATUS) {

                            env.APP_BUILD_STATUS = 'failed'
                        }
                    }
                }
            }
        }


        // ====================================================================
        // Stage 3
        // Firmware Metadata
        // ====================================================================

        stage('3. Generate Firmware Metadata') {

            when {

                expression {

                    return !params.SKIP_BUILD.toBoolean()
                }
            }


            steps {

                echo '[Stage3] Generating firmware metadata for CI traceability'


                script {

                    bat '''
@if not exist "%ARTIFACTS%" mkdir "%ARTIFACTS%"
'''


                    bat '''
@"%VENV_PY%" "%TOOLS%\\firmware_metadata.py" generate ^
 --chip "%CHIP%" ^
 --build-number "%BUILD_NUMBER%" ^
 --bootloader-sdk "1.0.3" ^
 --app-sdk "1.0.4" ^
 --app-image "app_fw.bin" ^
 --build-type "%BL_BUILD_STATUS%-APP-%APP_BUILD_STATUS%" ^
 --workspace "%W4%" ^
 --output "%ARTIFACTS%\\firmware_metadata.json"
'''


                    echo '[PASS] firmware_metadata.json generated'
                }
            }
        }


        // ====================================================================
        // Stage 4
        // Flash
        // ====================================================================

        stage('4. Flash') {

            when {

                expression {

                    return !params.SKIP_FLASH.toBoolean()
                }
            }


            stages {


                // ============================================================
                // 4.1 Detect Firmware Layout
                // ============================================================

                stage('4.1 Detect Firmware Layout') {

                    steps {

                        echo '[Stage4.1] Detecting firmware layout'


                        script {

                            def blMap =
                                "${env.BL_GCC}\\out\\lst\\app_bootloader.map"

                            def appMap =
                                "${env.APP_GCC}\\out\\lst\\ble_app_uart_c.map"

                            def blBin =
                                "${env.W4}\\bl_fw.bin"

                            def appBin =
                                "${env.W4}\\app_fw.bin"


                            // ------------------------------------------------
                            // Required files
                            // ------------------------------------------------

                            bat """
@if not exist "${blMap}" (
    echo ERROR: BL map missing
    exit /b 1
)

@if not exist "${blBin}" (
    echo ERROR: bl_fw.bin missing
    exit /b 1
)

@if not exist "${appBin}" (
    echo ERROR: app_fw.bin missing
    exit /b 1
)
"""


                            // ------------------------------------------------
                            // Detect layout
                            // ------------------------------------------------

                            def layoutCmd =
                                "@\"${env.VENV_PY}\" " +
                                "\"${env.TOOLS}\\detect_firmware_layout.py\" " +
                                "--bl-map \"${blMap}\" " +
                                "--bl-bin \"${blBin}\" " +
                                "--app-bin \"${appBin}\""


                            // ------------------------------------------------
                            // APP map is optional
                            // ------------------------------------------------

                            def appMapExists =
                                bat(
                                    returnStatus: true,
                                    script:
                                        "@if exist \"${appMap}\" exit /b 0 else exit /b 1"
                                ) == 0


                            if (appMapExists) {

                                layoutCmd +=
                                    " --app-map \"${appMap}\""

                            } else {

                                echo '[WARN] APP map file not found. APP RTT addr will use default/scan.'
                            }


                            // ------------------------------------------------
                            // Run detection
                            // ------------------------------------------------

                            def layoutOut =
                                bat(
                                    returnStdout: true,
                                    script: layoutCmd
                                ).trim()


                            layoutOut.split('\n').each { line ->

                                def parts =
                                    line.split('=', 2)


                                if (parts.length == 2) {

                                    def key =
                                        parts[0].trim()

                                    def val =
                                        parts[1].trim()


                                    if (
                                        key &&
                                        key ==~ /[A-Z_]+/
                                    ) {

                                        env."${key}" = val
                                    }
                                }
                            }


                            // ------------------------------------------------
                            // Layout validation
                            // ------------------------------------------------

                            if (!env.BL_ADDR || !env.APP_ADDR) {

                                if (
                                    params.ALLOW_LAYOUT_FALLBACK.toBoolean()
                                ) {

                                    echo '[WARN] WARNING: Firmware layout fallback is enabled.'
                                    echo '[WARN] This build MUST NOT be considered production CI.'
                                    echo '[WARN] Using hardcoded development layout addresses.'


                                    env.BL_ADDR =
                                        '0x00204000'

                                    env.BL_END =
                                        '0x0023FFFF'

                                    env.APP_ADDR =
                                        '0x00240000'

                                    env.APP_END =
                                        '0x00297FFF'

                                    env.BANK_B_ADDR =
                                        '0x00298000'

                                    env.BANK_B_END =
                                        '0x002EFFFF'


                                } else {

                                    error(
                                        'Firmware layout detection FAILED - ' +
                                        'missing BL_ADDR or APP_ADDR. ' +
                                        'Set ALLOW_LAYOUT_FALLBACK=true only in development.'
                                    )
                                }
                            }


                            echo(
                                "Layout detected: " +
                                "BL=${env.BL_ADDR}-${env.BL_END} " +
                                "APP=${env.APP_ADDR}-${env.APP_END} " +
                                "BANK_B=${env.BANK_B_ADDR}-${env.BANK_B_END} " +
                                "NVDS=${env.NVDS_ADDR}"
                            )


                            echo(
                                "RTT: " +
                                "BL=${env.BL_RTT_ADDR} " +
                                "APP=${env.APP_RTT_ADDR ?: 'not detected (will scan)'}"
                            )
                        }
                    }
                }


                // ============================================================
                // 4.2 Verify Firmware Metadata
                // ============================================================

                stage('4.2 Verify Firmware Metadata') {

                    steps {

                        echo '[Stage4.2] Verifying firmware metadata'


                        script {

                            def metaPath =
                                "${env.ARTIFACTS}\\firmware_metadata.json"


                            if (fileExists(metaPath)) {

                                bat '''
@"%VENV_PY%" "%TOOLS%\\firmware_metadata.py" verify ^
 --metadata "%ARTIFACTS%\\firmware_metadata.json" ^
 --workspace "%W4%"
'''


                                echo '[PASS] firmware_metadata.json verified'

                            } else {

                                echo '[WARN] firmware_metadata.json not found. Skipping metadata verification.'
                            }
                        }
                    }
                }


                // ============================================================
                // 4.3 Generate & Validate Flash Plan
                // ============================================================

                stage('4.3 Generate & Validate Flash Plan') {

                    steps {

                        echo '[Stage4.3] Generating flash plan'


                        script {

                            // ------------------------------------------------
                            // Generate plan
                            // ------------------------------------------------

                            bat '''
@"%VENV_PY%" "%CI_DIR%\\flash_plan.py" generate ^
 --chip "%CHIP%" ^
 --bl-addr "%BL_ADDR%" ^
 --bl-end "%BL_END%" ^
 --app-addr "%APP_ADDR%" ^
 --app-end "%APP_END%" ^
 --bank-b-addr "%BANK_B_ADDR%" ^
 --bank-b-end "%BANK_B_END%" ^
 --nvds-addr "%NVDS_ADDR%" ^
 --output "%ARTIFACTS%\\flash_plan.json"
'''


                            echo '[PASS] flash_plan.json generated'


                            // ------------------------------------------------
                            // Validate plan
                            // ------------------------------------------------

                            bat '''
@"%VENV_PY%" "%CI_DIR%\\flash_plan.py" validate ^
 --plan "%ARTIFACTS%\\flash_plan.json"
'''


                            echo '[PASS] flash_plan.json validated'
                            echo '[PASS] NVDS preserved'
                            echo '[PASS] App-first / Bootloader-last confirmed'
                        }
                    }
                }


                // ============================================================
                // 4.4 Human Confirmation
                // ============================================================

                stage('4.4 Hardware Flash Confirmation') {

                    when {

                        expression {

                            return !params.DRY_RUN.toBoolean()
                        }
                    }


                    steps {

                        echo '[Stage4.4] AWAITING HUMAN CONFIRMATION before real hardware flash'


                        script {

                            input(
                                message:
                                    'Confirm GR5526 hardware erase/program?',
                                ok:
                                    'Flash Device'
                            )


                            echo '[PASS] Human confirmation received.'
                            echo '[INFO] Proceeding with hardware flash.'
                        }
                    }
                }


                // ============================================================
                // 4.5 Erase
                // ============================================================

                stage('4.5 Erase Flash Regions') {

                    steps {

                        echo '[Stage4.5] Erasing BL + Bank A + Bank B'
                        echo '[HARD RULE] NVDS preserved. NO eraseall.'


                        script {

                            // ------------------------------------------------
                            // Bootloader region
                            // ------------------------------------------------

                            grConsole(
                                "eraseFlash " +
                                "--start ${env.BL_ADDR} " +
                                "--end ${env.BL_END} " +
                                "--chip ${env.CHIP} " +
                                "--jlink ${env.JLINK_IDX}"
                            )


                            echo(
                                "-> Bootloader region " +
                                "${env.BL_ADDR}-${env.BL_END} erased"
                            )


                            // ------------------------------------------------
                            // Bank A / APP
                            // ------------------------------------------------

                            grConsole(
                                "eraseFlash " +
                                "--start ${env.APP_ADDR} " +
                                "--end ${env.APP_END} " +
                                "--chip ${env.CHIP} " +
                                "--jlink ${env.JLINK_IDX}"
                            )


                            echo(
                                "-> Bank A " +
                                "${env.APP_ADDR}-${env.APP_END} erased"
                            )


                            // ------------------------------------------------
                            // Bank B
                            // ------------------------------------------------

                            grConsole(
                                "eraseFlash " +
                                "--start ${env.BANK_B_ADDR} " +
                                "--end ${env.BANK_B_END} " +
                                "--chip ${env.CHIP} " +
                                "--jlink ${env.JLINK_IDX}"
                            )


                            echo(
                                "-> Bank B " +
                                "${env.BANK_B_ADDR}-${env.BANK_B_END} erased"
                            )


                            echo '[PASS] Erase complete'
                            echo '[PASS] NVDS preserved'
                            echo '[PASS] No eraseall'
                        }
                    }
                }


                // ============================================================
                // 4.6 Program APP FIRST
                // ============================================================

                stage('4.6 Program App (FIRST)') {

                    steps {

                        echo '[Stage4.6] Programming APP FIRST'
                        echo '[HARD RULE] APP must be programmed BEFORE Bootloader'


                        script {

                            grConsole(
                                "program " +
                                "--chip ${env.CHIP} " +
                                "--file \"${env.W4}\\app_fw.bin\" " +
                                "--erase 2 " +
                                "--run false " +
                                "--jlink ${env.JLINK_IDX}"
                            )


                            echo '[PASS] APP programmed FIRST'
                        }
                    }
                }


                // ============================================================
                // 4.7 Program Bootloader LAST
                // ============================================================

                stage('4.7 Program Bootloader (LAST)') {

                    steps {

                        echo '[Stage4.7] Programming Bootloader LAST'
                        echo '[HARD RULE] Bootloader MUST be programmed LAST'
                        echo '[INFO] SCA final -> Bootloader'


                        script {

                            grConsole(
                                "program " +
                                "--chip ${env.CHIP} " +
                                "--file \"${env.W4}\\bl_fw.bin\" " +
                                "--erase 2 " +
                                "--run false " +
                                "--jlink ${env.JLINK_IDX}"
                            )


                            echo '[PASS] Bootloader programmed LAST'
                            echo '[PASS] SCA final -> Bootloader'
                        }
                    }
                }


                // ============================================================
                // 4.8 Flash Verify
                // ============================================================

                stage('4.8 Flash Verify (MANDATORY GATE)') {

                    steps {

                        echo '[Stage4.8] Verifying flash contents'
                        echo '[HARD RULE] Verification failure stops pipeline'


                        script {

                            // ------------------------------------------------
                            // Dump Bank A
                            // ------------------------------------------------

                            grConsole(
                                "dump " +
                                "${env.APP_ADDR} " +
                                "64 " +
                                "\"${env.WORKSPACE}\\verify_bank_a.bin\" " +
                                "${env.JLINK_IDX}"
                            )


                            echo '-> Bank A dump created'


                            // ------------------------------------------------
                            // Dump SCA
                            // ------------------------------------------------

                            grConsole(
                                "dump " +
                                "0x00200000 " +
                                "256 " +
                                "\"${env.WORKSPACE}\\verify_sca.bin\" " +
                                "${env.JLINK_IDX}"
                            )


                            echo '-> SCA dump created'


                            // ------------------------------------------------
                            // Verify
                            // ------------------------------------------------

                            echo 'Running flash verification...'


                            bat '''
@"%VENV_PY%" "%TOOLS%\\verify_flash.py"
'''


                            echo '[PASS] Flash verification passed'
                        }
                    }
                }


                // ============================================================
                // 4.9 Reset
                // ============================================================

                stage('4.9 Reset Device') {

                    steps {

                        echo '[Stage4.9] Resetting device via GR5xxx_console'
                        echo '[HARD RULE] NO J-Link reset'


                        script {

                            grConsole(
                                'reset 1 0'
                            )


                            echo 'Waiting 5s for GR5526 boot + RTT ready ...'


                            bat '''
@ping -n 6 127.0.0.1 >nul
'''


                            echo '[PASS] Device reset via GR5xxx_console'
                        }
                    }
                }
            }
        }


        // ====================================================================
        // Stage 5
        // Hardware Test / RTT Diagnostic
        // ====================================================================

        stage('5. Hardware Test (RTT Diagnostic)') {

            steps {

                echo '[Stage5] RTT diagnostic test'
                echo '[INFO] BL RTT -> wait for BL to APP -> APP RTT'
                echo '[INFO] RTT failure = UNSTABLE, not FAIL'


                script {

                    if (!env.BL_RTT_ADDR) {

                        echo '[WARN] BL_RTT_ADDR not detected.'
                    }


                    def blRtt =
                        env.BL_RTT_ADDR ?: '0x2000C830'


                    def appRtt =
                        env.APP_RTT_ADDR ?: '0x2000D000'


                    def blKw =
                        params.BL_KEYWORD ?: ''


                    def appKw =
                        params.APP_KEYWORD ?: ''


                    // --------------------------------------------------------
                    // DRY RUN
                    // --------------------------------------------------------

                    if (params.DRY_RUN.toBoolean()) {

                        echo(
                            "[DRY-RUN] test_rtt_with_jump.py " +
                            "--bl-rtt-addr ${blRtt} " +
                            "--app-rtt-addr ${appRtt} " +
                            "--jlink-serial ${env.JLINK_SERIAL} " +
                            "--bl-keyword '${blKw}' " +
                            "--app-keyword '${appKw}' " +
                            "--output rtt_result.json"
                        )


                        echo(
                            "[DRY-RUN] Would reset device and read BL RTT"
                        )


                        echo(
                            "[DRY-RUN] Would wait for BL -> APP jump"
                        )


                        echo(
                            "[DRY-RUN] Would read APP RTT"
                        )


                    } else {

                        // ----------------------------------------------------
                        // Real RTT test
                        // ----------------------------------------------------

                        def testCmd =
                            "@\"${env.VENV_PY}\" " +
                            "\"${env.TOOLS}\\test_rtt_with_jump.py\" " +
                            "--bl-rtt-addr ${blRtt} " +
                            "--app-rtt-addr ${appRtt} " +
                            "--jlink-serial ${env.JLINK_SERIAL} " +
                            "--bl-timeout 8 " +
                            "--jump-timeout 20 " +
                            "--output " +
                            "\"${env.WORKSPACE}\\rtt_result.json\""


                        if (blKw) {

                            testCmd +=
                                " --bl-keyword \"${blKw}\""
                        }


                        if (appKw) {

                            testCmd +=
                                " --app-keyword \"${appKw}\""
                        }


                        echo(
                            "Running RTT diagnostic " +
                            "(BL=${blRtt}, APP=${appRtt}) ..."
                        )


                        def testExit =
                            bat(
                                returnStatus: true,
                                script: testCmd
                            )


                        if (testExit != 0) {

                            echo(
                                "[WARN] RTT diagnostic exited with code ${testExit}"
                            )


                            echo(
                                '[WARN] Check rtt_result.json for details.'
                            )


                            // RTT is diagnostic only.
                            currentBuild.result = 'UNSTABLE'


                        } else {

                            echo '[PASS] RTT diagnostic passed'
                        }
                    }
                }
            }
        }
    }


    // ========================================================================
    // Post
    // ========================================================================

    post {

        success {

            echo 'gr5526-ci PASSED.'
        }


        failure {

            echo 'gr5526-ci FAILED.'
        }


        unstable {

            echo 'gr5526-ci UNSTABLE (RTT diagnostic may have failed).'
        }


        always {

            echo(
                "gr5526-ci done. " +
                "DRY_RUN=${params.DRY_RUN} " +
                "SKIP_BUILD=${params.SKIP_BUILD} " +
                "SKIP_FLASH=${params.SKIP_FLASH}"
            )


            echo(
                "BL build: ${env.BL_BUILD_STATUS ?: 'n/a'} | " +
                "APP build: ${env.APP_BUILD_STATUS ?: 'n/a'}"
            )


            // ---------------------------------------------------------------
            // Generate standardized result JSON
            // ---------------------------------------------------------------

            echo '[Post] Generating test_result.json'


            script {

                try {

                    def flashStatus =
                        params.SKIP_FLASH.toBoolean()
                            ? 'SKIPPED'
                            : (
                                params.DRY_RUN.toBoolean()
                                    ? 'DRY_RUN'
                                    : (
                                        currentBuild.currentResult == 'FAILURE'
                                            ? 'FAIL'
                                            : 'PASS'
                                    )
                            )


                    def resultJson = [

                        job:
                            env.JOB_NAME ?: 'gr5526-ci',

                        build_number:
                            (env.BUILD_NUMBER ?: '0') as int,

                        git_commit:
                            env.GIT_COMMIT ?: 'unknown',

                        chip:
                            env.CHIP ?: 'GR5526',

                        hardware_agent:
                            env.NODE_LABELS ?: 'gr5526-hw',


                        build_type:
                            (env.BL_BUILD_STATUS ?: 'n/a') +
                            '-' +
                            (env.APP_BUILD_STATUS ?: 'n/a'),


                        // ---------------------------------------------------
                        // Firmware projects
                        // ---------------------------------------------------

                        firmware_projects: [

                            bootloader:
                                env.BL_GCC ?: 'n/a',

                            app:
                                env.APP_GCC ?: 'n/a'
                        ],


                        // ---------------------------------------------------
                        // Flash result
                        // ---------------------------------------------------

                        flash: [

                            erase:
                                flashStatus,

                            app_program:
                                flashStatus,

                            boot_program:
                                flashStatus,

                            verify:
                                flashStatus
                        ],


                        // ---------------------------------------------------
                        // Hardware test
                        // ---------------------------------------------------

                        boot_test:
                            params.DRY_RUN.toBoolean()
                                ? 'DRY_RUN'
                                : (
                                    currentBuild.result == 'UNSTABLE'
                                        ? 'WARNING'
                                        : 'PASS'
                                ),


                        app_test:
                            params.DRY_RUN.toBoolean()
                                ? 'DRY_RUN'
                                : (
                                    currentBuild.result == 'UNSTABLE'
                                        ? 'WARNING'
                                        : 'PASS'
                                ),


                        // ---------------------------------------------------
                        // RTT
                        // ---------------------------------------------------

                        rtt: [

                            status:
                                currentBuild.result ?: 'PASS',

                            bl_rtt_addr:
                                env.BL_RTT_ADDR ?: 'not-detected',

                            app_rtt_addr:
                                env.APP_RTT_ADDR ?: 'not-detected',

                            notes:
                                'RTT is diagnostic/optional. UNSTABLE does not mean build failure.'
                        ],


                        warnings:
                            [],


                        timestamp:
                            new Date().format(
                                "yyyy-MM-dd'T'HH:mm:ss'Z'"
                            )
                    ]


                    writeFile(

                        file:
                            "${env.ARTIFACTS}\\test_result.json",

                        text:
                            groovy.json.JsonOutput.prettyPrint(
                                groovy.json.JsonOutput.toJson(
                                    resultJson
                                )
                            )
                    )


                    echo '[PASS] test_result.json generated'


                } catch (Exception e) {

                    echo(
                        "[WARN] Failed to generate test_result.json: " +
                        "${e.getMessage()}"
                    )
                }
            }


            // ---------------------------------------------------------------
            // Archive artifacts
            // ---------------------------------------------------------------

            archiveArtifacts(

                artifacts:
                    'artifacts/*.json,' +
                    '*.json,' +
                    '*.py,' +
                    '*.bin,' +
                    'verify_*.bin,' +
                    'rtt_result.json,' +
                    'obj_list.txt',

                allowEmptyArchive:
                    true
            )
        }
    }
}