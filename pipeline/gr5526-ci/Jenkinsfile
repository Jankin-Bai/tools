pipeline {
    agent {
        label 'gr5526-hw'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: true,
            description: 'Only validate/build/plan. No hardware flash.'
        )

        booleanParam(
            name: 'SKIP_BUILD',
            defaultValue: false,
            description: 'Skip firmware build and use existing artifacts.'
        )

        booleanParam(
            name: 'SKIP_FLASH',
            defaultValue: false,
            description: 'Skip all hardware flash operations.'
        )

        booleanParam(
            name: 'ALLOW_PREBUILT_FIRMWARE',
            defaultValue: false,
            description: 'Allow using existing prebuilt firmware artifacts.'
        )

        booleanParam(
            name: 'ALLOW_LAYOUT_FALLBACK',
            defaultValue: false,
            description: 'Allow firmware layout detection fallback.'
        )

        string(
            name: 'BL_PROJECT_PATH',
            defaultValue: 'D:\\Firmware\\wc2\\bootloader\\GCC',
            description: 'Bootloader project directory containing Makefile.'
        )

        string(
            name: 'APP_PROJECT_PATH',
            defaultValue: 'D:\\Firmware\\wc2\\app\\GCC',
            description: 'APP project directory containing Makefile.'
        )

        string(
            name: 'BL_KEYWORD',
            defaultValue: 'bootloader',
            description: 'Keyword used to identify Bootloader firmware.'
        )

        string(
            name: 'APP_KEYWORD',
            defaultValue: 'app',
            description: 'Keyword used to identify APP firmware.'
        )
    }

    environment {

        // ============================================================
        // CI infrastructure
        // ============================================================

        CI_ROOT   = 'D:\\JenkinsCI\\gr5526-ci'
        VENV_PY   = 'D:\\JenkinsCI\\gr5526-ci\\.venv\\Scripts\\python.exe'
        TOOLS     = 'D:\\JenkinsCI\\gr5526-ci\\tools'
        CI_DIR    = 'D:\\JenkinsCI\\gr5526-ci\\ci'
        ARTIFACTS = 'D:\\JenkinsCI\\gr5526-ci\\artifacts'


        // ============================================================
        // Firmware project
        // ============================================================

        BL_GCC = "${params.BL_PROJECT_PATH}"
        APP_GCC = "${params.APP_PROJECT_PATH}"


        // ============================================================
        // SDK
        // ============================================================

        BL_SDK = 'D:\\SDK\\GR5526_SDK_1.0.3'
        APP_SDK = 'D:\\SDK\\GR5526_SDK_1.0.4'


        // ============================================================
        // Hardware tools
        // ============================================================

        GR_CONSOLE = 'D:\\Tools\\GR5xxx_console\\GR5xxx_console.exe'
        JLINK_EXE = 'C:\\Program Files\\SEGGER\\JLink\\JLink.exe'


        // ============================================================
        // Runtime variables
        // ============================================================

        CHIP = ''
        JLINK_SERIAL = ''

        BL_ADDR = ''
        BL_END = ''

        APP_ADDR = ''
        APP_END = ''

        BANK_B_ADDR = ''
        BANK_B_END = ''

        NVDS_ADDR = ''

        FLASH_PLAN = ''
        BL_IMAGE = ''
        APP_IMAGE = ''
    }


    stages {

        // ============================================================
        // 1. Prepare Environment
        // ============================================================

        stage('1. Prepare Environment') {

            steps {
                script {

                    echo '''
============================================================
GR5526 CI - ENVIRONMENT CHECK
============================================================
'''

                    bat """
                        @echo off

                        if not exist "${env.CI_ROOT}" (
                            echo ERROR: CI_ROOT not found
                            exit /b 1
                        )

                        if not exist "${env.VENV_PY}" (
                            echo ERROR: Python virtual environment not found
                            exit /b 1
                        )

                        if not exist "${env.TOOLS}" (
                            echo ERROR: tools directory not found
                            exit /b 1
                        )

                        if not exist "${env.CI_DIR}" (
                            echo ERROR: ci directory not found
                            exit /b 1
                        )

                        if not exist "${env.ARTIFACTS}" (
                            mkdir "${env.ARTIFACTS}"
                        )

                        if not exist "${env.GR_CONSOLE}" (
                            echo ERROR: GR5xxx_console not found
                            exit /b 1
                        )

                        if not exist "${env.JLINK_EXE}" (
                            echo ERROR: J-Link not found
                            exit /b 1
                        )

                        if not exist "${env.BL_GCC}" (
                            echo ERROR: Bootloader project not found
                            echo ${env.BL_GCC}
                            exit /b 1
                        )

                        if not exist "${env.APP_GCC}" (
                            echo ERROR: APP project not found
                            echo ${env.APP_GCC}
                            exit /b 1
                        )

                        if not exist "${env.BL_SDK}" (
                            echo ERROR: Bootloader SDK not found
                            exit /b 1
                        )

                        if not exist "${env.APP_SDK}" (
                            echo ERROR: APP SDK not found
                            exit /b 1
                        )

                        where arm-none-eabi-gcc
                        if errorlevel 1 (
                            echo ERROR: ARM GCC not found
                            exit /b 1
                        )

                        where mingw32-make
                        if errorlevel 1 (
                            echo ERROR: mingw32-make not found
                            exit /b 1
                        )

                        echo.
                        echo Environment check passed.
                    """


                    echo 'Checking CI Python scripts...'

                    bat """
                        @echo off

                        "${env.VENV_PY}" "${env.TOOLS}\\jlink_detect.py"
                        if errorlevel 1 exit /b 1

                        if not exist "${env.TOOLS}\\detect_firmware_layout.py" exit /b 1
                        if not exist "${env.TOOLS}\\generate_image_info.py" exit /b 1
                        if not exist "${env.TOOLS}\\firmware_metadata.py" exit /b 1
                        if not exist "${env.TOOLS}\\verify_flash.py" exit /b 1
                        if not exist "${env.TOOLS}\\test_rtt_with_jump.py" exit /b 1
                        if not exist "${env.CI_DIR}\\flash_plan.py" exit /b 1
                    """


                    echo 'Detecting J-Link...'

                    bat """
                        @echo off

                        "${env.VENV_PY}" ^
                            "${env.TOOLS}\\jlink_detect.py" ^
                            --output "${env.ARTIFACTS}\\jlink.json"

                        if errorlevel 1 exit /b 1
                    """


                    // Read J-Link information if generated.
                    if (fileExists("${env.ARTIFACTS}\\jlink.json")) {

                        def jlinkJson = readJSON(
                            file: "${env.ARTIFACTS}\\jlink.json"
                        )

                        if (jlinkJson.serial) {
                            env.JLINK_SERIAL = "${jlinkJson.serial}"
                        }

                        if (jlinkJson.chip) {
                            env.CHIP = "${jlinkJson.chip}"
                        }
                    }

                    if (!env.CHIP?.trim()) {
                        env.CHIP = 'GR5526'
                    }


                    echo """
============================================================
Environment
============================================================

CI_ROOT       = ${env.CI_ROOT}
TOOLS         = ${env.TOOLS}
CI_DIR        = ${env.CI_DIR}
ARTIFACTS     = ${env.ARTIFACTS}

Bootloader    = ${env.BL_GCC}
APP           = ${env.APP_GCC}

Bootloader SDK = ${env.BL_SDK}
APP SDK        = ${env.APP_SDK}

Chip          = ${env.CHIP}
J-Link Serial = ${env.JLINK_SERIAL}

============================================================
"""
                }
            }
        }


        // ============================================================
        // 2. Build
        // ============================================================

        stage('2. Build') {

            when {
                expression {
                    return !params.SKIP_BUILD
                }
            }

            parallel {

                stage('2.1 Build Bootloader') {

                    steps {
                        script {

                            echo '''
============================================================
BUILD BOOTLOADER
============================================================
'''

                            bat """
                                @echo off
                                cd /d "${env.BL_GCC}"

                                mingw32-make clean
                                if errorlevel 1 exit /b 1

                                mingw32-make -j
                                if errorlevel 1 exit /b 1
                            """
                        }
                    }
                }


                stage('2.2 Build APP') {

                    steps {
                        script {

                            echo '''
============================================================
BUILD APP
============================================================
'''

                            bat """
                                @echo off
                                cd /d "${env.APP_GCC}"

                                mingw32-make clean
                                if errorlevel 1 exit /b 1

                                mingw32-make -j
                                if errorlevel 1 exit /b 1
                            """
                        }
                    }
                }
            }
        }


        // ============================================================
        // 3. Firmware Metadata
        // ============================================================

        stage('3. Generate Firmware Metadata') {

            steps {
                script {

                    echo '''
============================================================
GENERATE FIRMWARE METADATA
============================================================
'''

                    bat """
                        @echo off

                        "${env.VENV_PY}" ^
                            "${env.TOOLS}\\generate_image_info.py" ^
                            --bl "${env.BL_GCC}" ^
                            --app "${env.APP_GCC}" ^
                            --output "${env.ARTIFACTS}\\image_info.json"

                        if errorlevel 1 exit /b 1
                    """


                    bat """
                        @echo off

                        "${env.VENV_PY}" ^
                            "${env.TOOLS}\\firmware_metadata.py" ^
                            --bl "${env.BL_GCC}" ^
                            --app "${env.APP_GCC}" ^
                            --output "${env.ARTIFACTS}\\firmware_metadata.json"

                        if errorlevel 1 exit /b 1
                    """
                }
            }
        }


        // ============================================================
        // 4. Flash
        // ============================================================

        stage('4. Flash') {

            stages {

                // ----------------------------------------------------
                // 4.1 Detect Firmware Layout
                // ----------------------------------------------------

                stage('4.1 Detect Firmware Layout') {

                    steps {
                        script {

                            echo '''
============================================================
DETECT FIRMWARE LAYOUT
============================================================
'''

                            bat """
                                @echo off

                                "${env.VENV_PY}" ^
                                    "${env.TOOLS}\\detect_firmware_layout.py" ^
                                    --chip "${env.CHIP}" ^
                                    --bl "${env.BL_GCC}" ^
                                    --app "${env.APP_GCC}" ^
                                    --output "${env.ARTIFACTS}\\flash_layout.json"

                                if errorlevel 1 (
                                    if "${params.ALLOW_LAYOUT_FALLBACK}"=="true" (
                                        echo WARNING: Layout detection failed.
                                        echo Fallback is explicitly enabled.
                                    ) else (
                                        echo ERROR: Firmware layout detection failed.
                                        exit /b 1
                                    )
                                )
                            """


                            if (fileExists(
                                "${env.ARTIFACTS}\\flash_layout.json"
                            )) {

                                def layout = readJSON(
                                    file:
                                        "${env.ARTIFACTS}\\flash_layout.json"
                                )

                                env.BL_ADDR =
                                    "${layout.bootloader.address}"

                                env.BL_END =
                                    "${layout.bootloader.end}"

                                env.APP_ADDR =
                                    "${layout.app.address}"

                                env.APP_END =
                                    "${layout.app.end}"

                                env.BANK_B_ADDR =
                                    "${layout.bank_b.address}"

                                env.BANK_B_END =
                                    "${layout.bank_b.end}"

                                env.NVDS_ADDR =
                                    "${layout.nvds.address}"
                            }
                        }


                        echo """
Detected Flash Layout:

Bootloader:
    ${env.BL_ADDR} -> ${env.BL_END}

APP:
    ${env.APP_ADDR} -> ${env.APP_END}

Bank B:
    ${env.BANK_B_ADDR} -> ${env.BANK_B_END}

NVDS:
    ${env.NVDS_ADDR}

"""
                    }
                }


                // ----------------------------------------------------
                // 4.2 Verify Metadata
                // ----------------------------------------------------

                stage('4.2 Verify Metadata') {

                    steps {
                        script {

                            echo '''
============================================================
VERIFY FIRMWARE METADATA
============================================================
'''

                            bat """
                                @echo off

                                "${env.VENV_PY}" ^
                                    "${env.TOOLS}\\firmware_metadata.py" ^
                                    --verify ^
                                    --metadata "${env.ARTIFACTS}\\firmware_metadata.json"

                                if errorlevel 1 exit /b 1
                            """
                        }
                    }
                }


                // ----------------------------------------------------
                // 4.3 Generate Flash Plan
                // ----------------------------------------------------

                stage('4.3 Generate Flash Plan') {

                    steps {
                        script {

                            echo '''
============================================================
GENERATE FLASH PLAN
============================================================
'''

                            bat """
                                @echo off

                                "${env.VENV_PY}" ^
                                    "${env.CI_DIR}\\flash_plan.py" ^
                                    --layout "${env.ARTIFACTS}\\flash_layout.json" ^
                                    --metadata "${env.ARTIFACTS}\\firmware_metadata.json" ^
                                    --output "${env.ARTIFACTS}\\flash_plan.json"

                                if errorlevel 1 exit /b 1
                            """


                            if (fileExists(
                                "${env.ARTIFACTS}\\flash_plan.json"
                            )) {

                                def plan = readJSON(
                                    file:
                                        "${env.ARTIFACTS}\\flash_plan.json"
                                )

                                echo """
Flash plan generated successfully.

Erase:
    Bootloader
    Bank A
    Bank B

Preserved:
    NVDS

Program order:
    APP
    Bootloader
"""
                            }
                        }
                    }
                }


                // ----------------------------------------------------
                // 4.4 HARDWARE CONFIRMATION
                // ----------------------------------------------------

                stage('4.4 Hardware Flash Confirmation') {

                    when {
                        expression {
                            return !params.DRY_RUN &&
                                   !params.SKIP_FLASH
                        }
                    }

                    steps {
                        script {

                            input(
                                message:
"""
============================================================
GR5526 HARDWARE FLASH CONFIRMATION
============================================================

Chip:
    ${env.CHIP}

J-Link:
    Serial: ${env.JLINK_SERIAL}

Bootloader Project:
    ${env.BL_GCC}

APP Project:
    ${env.APP_GCC}


------------------------------------------------------------
FLASH LAYOUT
------------------------------------------------------------

Bootloader:
    ${env.BL_ADDR} -> ${env.BL_END}

APP:
    ${env.APP_ADDR} -> ${env.APP_END}

Bank B:
    ${env.BANK_B_ADDR} -> ${env.BANK_B_END}

NVDS:
    ${env.NVDS_ADDR}
    PRESERVED


------------------------------------------------------------
FLASH SEQUENCE
------------------------------------------------------------

1. Erase Bootloader
2. Erase Bank A
3. Erase Bank B
4. Program APP FIRST
5. Program Bootloader LAST
6. Verify Flash
7. Reset Device


------------------------------------------------------------
IMPORTANT
------------------------------------------------------------

This operation will MODIFY GR5526 FLASH.

NVDS will NOT be intentionally erased.

APP will be programmed BEFORE Bootloader.

Please verify the physical DUT and J-Link
before continuing.

============================================================
""",
                                ok: 'Flash Device'
                            )
                        }
                    }
                }


                // ----------------------------------------------------
                // 4.5 Erase
                // ----------------------------------------------------

                stage('4.5 Erase Flash') {

                    when {
                        expression {
                            return !params.DRY_RUN &&
                                   !params.SKIP_FLASH
                        }
                    }

                    steps {
                        script {

                            echo '''
============================================================
ERASE FLASH
============================================================

Erase:
    Bootloader
    Bank A
    Bank B

Preserve:
    NVDS
============================================================
'''

                            bat """
                                @echo off

                                "${env.GR_CONSOLE}" ^
                                    --erase-bl

                                if errorlevel 1 exit /b 1

                                "${env.GR_CONSOLE}" ^
                                    --erase-bank-a

                                if errorlevel 1 exit /b 1

                                "${env.GR_CONSOLE}" ^
                                    --erase-bank-b

                                if errorlevel 1 exit /b 1
                            """
                        }
                    }
                }


                // ----------------------------------------------------
                // 4.6 Program APP
                // ----------------------------------------------------

                stage('4.6 Program APP FIRST') {

                    when {
                        expression {
                            return !params.DRY_RUN &&
                                   !params.SKIP_FLASH
                        }
                    }

                    steps {
                        script {

                            echo '''
============================================================
PROGRAM APP
============================================================
'''

                            bat """
                                @echo off

                                "${env.GR_CONSOLE}" ^
                                    --program ^
                                    --image "${env.APP_IMAGE}" ^
                                    --address "${env.APP_ADDR}"

                                if errorlevel 1 exit /b 1
                            """
                        }
                    }
                }


                // ----------------------------------------------------
                // 4.7 Program Bootloader
                // ----------------------------------------------------

                stage('4.7 Program Bootloader LAST') {

                    when {
                        expression {
                            return !params.DRY_RUN &&
                                   !params.SKIP_FLASH
                        }
                    }

                    steps {
                        script {

                            echo '''
============================================================
PROGRAM BOOTLOADER
============================================================
'''

                            bat """
                                @echo off

                                "${env.GR_CONSOLE}" ^
                                    --program ^
                                    --image "${env.BL_IMAGE}" ^
                                    --address "${env.BL_ADDR}"

                                if errorlevel 1 exit /b 1
                            """
                        }
                    }
                }


                // ----------------------------------------------------
                // 4.8 Verify Flash
                // ----------------------------------------------------

                stage('4.8 Flash Verify') {

                    when {
                        expression {
                            return !params.DRY_RUN &&
                                   !params.SKIP_FLASH
                        }
                    }

                    steps {
                        script {

                            echo '''
============================================================
VERIFY FLASH
============================================================
'''

                            bat """
                                @echo off

                                "${env.VENV_PY}" ^
                                    "${env.TOOLS}\\verify_flash.py" ^
                                    --chip "${env.CHIP}" ^
                                    --layout "${env.ARTIFACTS}\\flash_layout.json" ^
                                    --metadata "${env.ARTIFACTS}\\firmware_metadata.json"

                                if errorlevel 1 exit /b 1
                            """
                        }
                    }
                }


                // ----------------------------------------------------
                // 4.9 Reset
                // ----------------------------------------------------

                stage('4.9 Reset Device') {

                    when {
                        expression {
                            return !params.DRY_RUN &&
                                   !params.SKIP_FLASH
                        }
                    }

                    steps {
                        script {

                            echo '''
============================================================
RESET DEVICE
============================================================
'''

                            bat """
                                @echo off

                                "${env.GR_CONSOLE}" --reset

                                if errorlevel 1 exit /b 1
                            """
                        }
                    }
                }
            }
        }


        // ============================================================
        // 5. RTT Diagnostic
        // ============================================================

        stage('5. RTT Diagnostic') {

            when {
                expression {
                    return !params.DRY_RUN &&
                           !params.SKIP_FLASH
                }
            }

            steps {
                script {

                    echo '''
============================================================
RTT DIAGNOSTIC
============================================================
'''

                    bat """
                        @echo off

                        "${env.VENV_PY}" ^
                            "${env.TOOLS}\\test_rtt_with_jump.py" ^
                            --chip "${env.CHIP}" ^
                            --serial "${env.JLINK_SERIAL}" ^
                            --output "${env.ARTIFACTS}\\rtt_result.json"

                        if errorlevel 1 (
                            echo WARNING: RTT diagnostic failed.
                            exit /b 1
                        )
                    """
                }
            }
        }
    }


    // ================================================================
    // POST
    // ================================================================

    post {

        always {

            script {

                echo '''
============================================================
GENERATE TEST RESULT
============================================================
'''

                def resultData = [
                    build_number : env.BUILD_NUMBER,
                    build_url    : env.BUILD_URL,
                    result       : currentBuild.currentResult,
                    dry_run      : params.DRY_RUN,
                    skip_build   : params.SKIP_BUILD,
                    skip_flash   : params.SKIP_FLASH,
                    chip         : env.CHIP,
                    jlink_serial : env.JLINK_SERIAL,
                    bl_project   : env.BL_GCC,
                    app_project  : env.APP_GCC
                ]

                writeJSON(
                    file: "${env.ARTIFACTS}\\test_result.json",
                    json: resultData,
                    pretty: 4
                )


                archiveArtifacts(
                    artifacts:
                        'artifacts/**/*',
                    allowEmptyArchive: true,
                    fingerprint: true
                )
            }
        }


        success {

            echo '''
============================================================
GR5526 CI SUCCESS
============================================================
'''
        }


        failure {

            echo '''
============================================================
GR5526 CI FAILED
============================================================

Please inspect Jenkins console output and artifacts.

============================================================
'''
        }


        aborted {

            echo '''
============================================================
GR5526 CI ABORTED
============================================================
'''
        }
    }
}